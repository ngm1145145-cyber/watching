<UserControl x:Class="Watching.Desktop.ScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <Grid Background="Black" ClipToBounds="True">

        <Image x:Name="ScreenImage" Stretch="Uniform" SnapsToDevicePixels="True"
               RenderOptions.BitmapScalingMode="HighQuality" />

        <!-- 顶部控制条（全屏时自动隐藏） -->
        <Border x:Name="Hud" VerticalAlignment="Top" Background="#CC0B0E14" Padding="10,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="QualityButton" Content="画质:中" Style="{StaticResource FlatButton}"
                            Click="Quality_Click" Margin="6,0,0,0" ToolTip="点击循环切换 流畅 / 中 / 高清" />
                    <Button Content="适应窗口" Style="{StaticResource FlatButton}" Click="Fit_Click" Margin="6,0,0,0" />
                    <Button Content="截图" Style="{StaticResource FlatButton}" Click="Snapshot_Click" Margin="6,0,0,0" />
                    <Button x:Name="FullscreenButton" Content="全屏 (F11)" Style="{StaticResource AccentButton}"
                            Click="Fullscreen_Click" Margin="6,0,0,0" />
                    <Button x:Name="ExitButton" Content="断开" Style="{StaticResource FlatButton}"
                            Click="Exit_Click" Margin="6,0,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusPill" Text="等待画面…" VerticalAlignment="Center" Margin="2,0,10,0" />
                    <TextBlock x:Name="ErrorPill" Foreground="#FCA5A5" VerticalAlignment="Center"
                               Visibility="Collapsed" TextWrapping="NoWrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 底部：缩放条 -->
        <Border x:Name="ZoomBar" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Background="#CC0B0E14" CornerRadius="8" Padding="12,6" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="FitToggle" Content="适应窗口" IsChecked="True" VerticalAlignment="Center"
                          Checked="Fit_Changed" Unchecked="Fit_Changed" />
                <Slider x:Name="ZoomSlider" Width="180" Minimum="0.2" Maximum="6" Value="1"
                        Margin="14,0,0,0" VerticalAlignment="Center"
                        ValueChanged="Zoom_Changed" />
            </StackPanel>
        </Border>

        <!-- 全屏时的角落状态 -->
        <TextBlock x:Name="MirrorStatus" VerticalAlignment="Top" HorizontalAlignment="Left"
                   Margin="10,6,0,0" Foreground="#9AA4B2" Visibility="Collapsed" />
    </Grid>
</UserControl>
