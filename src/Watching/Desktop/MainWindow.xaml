<Window x:Class="Watching.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Watching.Desktop"
        Title="Watching 电脑客户端" Height="760" Width="1200"
        MinHeight="420" MinWidth="680"
        Background="{StaticResource Bg}"
        KeyDown="Window_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 连接栏 -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" Padding="12,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <CheckBox x:Name="RemoteCheck" Content="允许远程控制" VerticalAlignment="Center"
                              Margin="0,0,12,0" IsEnabled="False"
                              ToolTip="需要服务端在设置里开启“允许远程控制”" />
                    <Button x:Name="ConnectButton" Content="连接" Style="{StaticResource AccentButton}"
                            Click="Connect_Click" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="服务端 IP" VerticalAlignment="Center" Foreground="{StaticResource FgDim}"
                               Margin="0,0,8,0" />
                    <TextBox x:Name="HostBox" Width="180" Height="30" VerticalContentAlignment="Center"
                             ToolTip="例如 192.168.1.8" />
                    <TextBlock Text="端口" VerticalAlignment="Center" Foreground="{StaticResource FgDim}"
                               Margin="12,0,8,0" />
                    <TextBox x:Name="PortBox" Width="70" Height="30" VerticalContentAlignment="Center" Text="8899" />
                    <TextBlock Text="密码" VerticalAlignment="Center" Foreground="{StaticResource FgDim}"
                               Margin="12,0,8,0" />
                    <PasswordBox x:Name="PwdBox" Width="120" Height="30" VerticalContentAlignment="Center"
                                 ToolTip="服务端未开启访问密码时留空" />
                    <Button x:Name="SearchButton" Content="搜索服务端" Style="{StaticResource FlatButton}" Margin="10,0,0,0"
                            Click="Search_Click" ToolTip="在局域网里自动找服务端，不用手抄 IP" />
                    <Button Content="本机地址" Style="{StaticResource FlatButton}" Margin="6,0,0,0"
                            Click="Local_Click" ToolTip="把 127.0.0.1 填进去（服务端就在这台电脑上时）" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 画面 -->
        <local:ScreenView x:Name="View" Grid.Row="1" />

        <!-- 状态栏 -->
        <Border Grid.Row="2" Background="{StaticResource Panel}" Padding="12,7">
            <DockPanel>
                <TextBlock x:Name="StateText" DockPanel.Dock="Left" Text="未连接"
                           Foreground="{StaticResource FgDim}" VerticalAlignment="Center" />
                <TextBlock x:Name="HintText" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{StaticResource FgDim}"
                           Text="F11 全屏 · Ctrl+滚轮 缩放 · Esc 退出全屏" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
