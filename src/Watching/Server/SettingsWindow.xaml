<Window x:Class="Watching.Server.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Watching 服务端设置" Height="700" Width="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="服务端设置" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="SubtitleText" Margin="0,4,0,0" Foreground="{StaticResource FgDim}" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 远程控制 -->
                <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="远程控制" FontSize="15" FontWeight="SemiBold" />
                        <CheckBox x:Name="RemoteCheck" Margin="0,12,0,0"
                                  Content="允许客户端远程控制本机鼠标和键盘" />
                        <TextBlock Margin="0,8,0,0" Foreground="{StaticResource FgDim}" TextWrapping="Wrap"
                                   Text="默认关闭。开启后，任何连接到本服务端的客户端都能操作这台电脑。需要先设置密码。" />
                    </StackPanel>
                </Border>

                <!-- 画质 -->
                <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="画面质量" FontSize="15" FontWeight="SemiBold" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="帧率" VerticalAlignment="Center" />
                            <Slider x:Name="FpsSlider" Grid.Column="1" Minimum="1" Maximum="60" TickFrequency="1"
                                    IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                    ValueChanged="Fps_Changed" />
                            <TextBlock x:Name="FpsText" Grid.Column="2" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Foreground="{StaticResource FgDim}" />
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="画质" VerticalAlignment="Center" />
                            <Slider x:Name="QualitySlider" Grid.Column="1" Minimum="20" Maximum="95" TickFrequency="1"
                                    IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                    ValueChanged="Quality_Changed" />
                            <TextBlock x:Name="QualityText" Grid.Column="2" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Foreground="{StaticResource FgDim}" />
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="发送宽度" VerticalAlignment="Center" />
                            <Slider x:Name="WidthSlider" Grid.Column="1" Minimum="480" Maximum="3840" TickFrequency="80"
                                    IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                    ValueChanged="Width_Changed" />
                            <TextBlock x:Name="WidthText" Grid.Column="2" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Foreground="{StaticResource FgDim}" />
                        </Grid>

                        <TextBlock Margin="0,10,0,0" Foreground="{StaticResource FgDim}" TextWrapping="Wrap"
                                   Text="宽度越小越省流量。客户端也可以在连接后单独调整自己的画质，不影响其它客户端。" />
                    </StackPanel>
                </Border>

                <!-- 安全 -->
                <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="安全" FontSize="15" FontWeight="SemiBold" />

                        <CheckBox x:Name="AccessCheck" Margin="0,12,0,0" Content="客户端连接需要访问密码"
                                  Checked="Access_Toggled" Unchecked="Access_Toggled" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="AccessBox" Grid.Column="0" Height="32" VerticalContentAlignment="Center"
                                     FontFamily="Consolas" />
                            <Button Grid.Column="1" Content="生成随机密码" Style="{StaticResource FlatButton}"
                                    Margin="8,0,0,0" Click="RandomPwd_Click" />
                        </Grid>
                        <TextBlock Margin="0,8,0,0" Foreground="{StaticResource FgDim}" TextWrapping="Wrap"
                                   Text="开启后，电脑/手机客户端连接时都需要输入这个密码。" />

                        <Separator Margin="0,16,0,14" Background="{StaticResource Line}" />

                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="PwdStateText" VerticalAlignment="Center" Foreground="{StaticResource FgDim}" />
                            <Button x:Name="PwdButton" Content="设置密码" Style="{StaticResource FlatButton}"
                                    Margin="10,0,0,0" Click="SetPassword_Click" />
                        </StackPanel>
                        <TextBlock Margin="0,8,0,0" Foreground="{StaticResource FgDim}" TextWrapping="Wrap"
                                   Text="设置密码后，每次打开本设置窗口都需要输入密码。（首次未设置密码时可直接进入设置）" />
                    </StackPanel>
                </Border>

                <!-- 启动 -->
                <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="启动方式" FontSize="15" FontWeight="SemiBold" />
                        <CheckBox x:Name="AutoStartCheck" Margin="0,12,0,0" Content="开机自动启动服务端（静默后台运行）" />
                        <TextBlock Margin="0,8,0,0" Foreground="{StaticResource FgDim}" TextWrapping="Wrap"
                                   Text="服务端没有任何主窗口，只在托盘显示一个小图标；退出服务端请在托盘图标上右键。" />
                        <TextBlock x:Name="ListenText" Margin="0,10,0,0" Foreground="{StaticResource FgDim}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 网络与发现 -->
                <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="网络与自动发现" FontSize="15" FontWeight="SemiBold" />

                        <TextBlock x:Name="NetworkStatusText" Margin="0,12,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource Fg}" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="重新体检" Style="{StaticResource FlatButton}" Click="NetCheck_Click" />
                            <Button x:Name="FixFirewallButton" Content="一键放行防火墙"
                                    Style="{StaticResource AccentButton}" Margin="8,0,0,0" Click="FixFirewall_Click" />
                        </StackPanel>

                        <TextBlock x:Name="NetworkDetailText" Margin="0,12,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource FgDim}" FontFamily="Consolas" FontSize="12" />

                        <CheckBox x:Name="DiscoveryCheck" Margin="0,14,0,0"
                                  Content="启用局域网自动发现（UDP 广播，客户端不用手填 IP）" />
                        <CheckBox x:Name="SkipUnchangedCheck" Margin="0,8,0,0"
                                  Content="静止画面跳过重复帧（省流量）" />
                        <CheckBox x:Name="AdaptiveCheck" Margin="0,8,0,0"
                                  Content="网络拥塞时自动降低画质（保证不卡）" />
                        <CheckBox x:Name="DrawCursorCheck" Margin="0,8,0,0"
                                  Content="把鼠标光标画进画面（Windows 抓屏默认不含光标，关了客户端就看不到鼠标）" />
                    </StackPanel>
                </Border>

                <!-- 客户端 -->
                <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="当前连接的客户端" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock x:Name="ClientsText" Margin="0,10,0,0" Foreground="{StaticResource FgDim}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="查看日志" Style="{StaticResource FlatButton}" Margin="0,0,10,0" Click="Log_Click" />
            <Button Content="保存并关闭" Style="{StaticResource AccentButton}" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
